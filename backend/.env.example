PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ipoms_db
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOG_LEVEL=debug

# ── Destructive boot tooling — leave unset in any environment with real data ──
# SEED_ON_BOOT=true empties daily_leads, active_leads, weekly_tracker and
# company_metadata on startup and refills them from the demo fixtures and the
# Excel workbooks in C:\Users\admin\Downloads. Local demo resets only.
SEED_ON_BOOT=false
# RESET_ACCOUNTS_ON_BOOT=true rewrites every seeded account's password, role and
# assigned colleges back to defaults, and clears lockouts, profile locks and
# soft-deletion. Use only to reset a throwaway dev database.
RESET_ACCOUNTS_ON_BOOT=false

# SMTP Mailer Configuration (Office 365 / Exchange)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="iPOMS Placement Operations <placement_management@infoziant.com>"
