{
  "name": "ipoms-backend",
  "version": "1.0.0",
  "description": "Infoziant Placement Operations Management System - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:meta": "ts-node src/scripts/seedMetaDatabase.ts",
    "seed:admin": "ts-node src/scripts/seedRolesAndAdmin.ts",
    "unlock": "ts-node src/scripts/unlockUser.ts",
    "verify:policy": "ts-node src/scripts/verifyRoutePolicy.ts",
    "fix:roles": "ts-node src/scripts/fixRoleCodes.ts"
  },
  "keywords": [
    "ipoms",
    "infoziant",
    "placement",
    "mongodb",
    "express"
  ],
  "author": "Infoziant",
  "license": "ISC",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.14.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
