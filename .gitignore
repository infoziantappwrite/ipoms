# ===========================
# iPOMS .gitignore
# ===========================

# --- Secrets ---
.env
*.env
!.env.example

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS Files ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Large Binary Files (keep on OneDrive instead) ---
# Uncomment the lines below if you want to exclude them:
# version 1/Presentations/*.pptx
# version 1/Prompt Sources/*.docx
# version 1/Module Workflow/*.docx

# --- Sensitive / Business Documents ---
# Uncomment if you don't want quotation/pricing files on GitHub:
# approval documents/iPOMS Quotation.pdf

# --- Empty directories ---
version 1/PDF/

# --- Temporary / Build files ---
*.tmp
*.log
*.bak

# Dependencies
node_modules/
.next/
*.node
backups/

# Compiled backend output — regenerated by `npm run build`, was tracked in git
# (199 files) which is the same class of problem `.next/` above already caused:
# a build artifact competing with the compiler for the same directory. See
# CLAUDE.md §5 item 44/item 3.
backend/dist/

# Local test credentials/tokens — never commit
frontend/coord.json
frontend/coord_token.txt
